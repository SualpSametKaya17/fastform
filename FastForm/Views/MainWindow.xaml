<Window x:Class="FastForm.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="FastForm - Form Doldurma Sistemi"
        Height="800" Width="1400"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource MaterialDesignPaper}"
        FontFamily="{DynamicResource MaterialDesignFont}">

    <materialDesign:DialogHost Identifier="RootDialog">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Top Bar -->
            <materialDesign:ColorZone Grid.Row="0" Mode="PrimaryMid" Padding="16" materialDesign:ElevationAssist.Elevation="Dp4">
                <DockPanel>
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                        <materialDesign:PackIcon Kind="FormSelect" Width="32" Height="32" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="FastForm" FontSize="24" FontWeight="Bold" VerticalAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right">
                        <Button Style="{StaticResource ToolbarIconButton}" ToolTip="Bildirimler">
                            <materialDesign:PackIcon Kind="Bell" Width="20" Height="20"/>
                        </Button>
                        <Button Style="{StaticResource ToolbarIconButton}" ToolTip="Ayarlar">
                            <materialDesign:PackIcon Kind="Settings" Width="20" Height="20"/>
                        </Button>
                        <Button Style="{StaticResource ToolbarIconButton}" ToolTip="Kullanıcı">
                            <materialDesign:PackIcon Kind="Account" Width="20" Height="20"/>
                        </Button>
                    </StackPanel>

                    <TextBlock Text="{Binding CurrentPageTitle}"
                               FontSize="20"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Center"
                               Margin="16,0"/>
                </DockPanel>
            </materialDesign:ColorZone>

            <!-- Main Content -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="250"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Navigation Menu -->
                <Border Grid.Column="0" Background="{DynamicResource MaterialDesignCardBackground}"
                        BorderBrush="{DynamicResource MaterialDesignDivider}" BorderThickness="0,0,1,0"
                        materialDesign:ElevationAssist.Elevation="Dp2">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="0,16">
                            <!-- Dashboard -->
                            <Button Style="{StaticResource NavigationButton}"
                                    Height="50" HorizontalContentAlignment="Left"
                                    Command="{Binding NavigateToDashboardCommand}">
                                <StackPanel Orientation="Horizontal" Margin="16,0">
                                    <materialDesign:PackIcon Kind="ViewDashboard" Width="24" Height="24" VerticalAlignment="Center"/>
                                    <TextBlock Text="Kontrol Paneli" Margin="16,0" VerticalAlignment="Center" FontSize="14"/>
                                </StackPanel>
                            </Button>

                            <!-- Templates -->
                            <Button Style="{StaticResource NavigationButton}"
                                    Height="50" HorizontalContentAlignment="Left"
                                    Command="{Binding NavigateToTemplatesCommand}">
                                <StackPanel Orientation="Horizontal" Margin="16,0">
                                    <materialDesign:PackIcon Kind="FileDocument" Width="24" Height="24" VerticalAlignment="Center"/>
                                    <TextBlock Text="Form Şablonları" Margin="16,0" VerticalAlignment="Center" FontSize="14"/>
                                </StackPanel>
                            </Button>

                            <!-- Forms -->
                            <Button Style="{StaticResource NavigationButton}"
                                    Height="50" HorizontalContentAlignment="Left"
                                    Command="{Binding NavigateToFormsCommand}">
                                <StackPanel Orientation="Horizontal" Margin="16,0">
                                    <materialDesign:PackIcon Kind="FileDocumentMultiple" Width="24" Height="24" VerticalAlignment="Center"/>
                                    <TextBlock Text="Formlar" Margin="16,0" VerticalAlignment="Center" FontSize="14"/>
                                </StackPanel>
                            </Button>

                            <Separator Margin="16,8"/>

                            <!-- New Template -->
                            <Button Style="{StaticResource NavigationButton}"
                                    Height="50" HorizontalContentAlignment="Left">
                                <StackPanel Orientation="Horizontal" Margin="16,0">
                                    <materialDesign:PackIcon Kind="FilePlus" Width="24" Height="24" VerticalAlignment="Center"/>
                                    <TextBlock Text="Yeni Şablon" Margin="16,0" VerticalAlignment="Center" FontSize="14"/>
                                </StackPanel>
                            </Button>

                            <!-- New Form -->
                            <Button Style="{StaticResource NavigationButton}"
                                    Height="50" HorizontalContentAlignment="Left">
                                <StackPanel Orientation="Horizontal" Margin="16,0">
                                    <materialDesign:PackIcon Kind="FileDocumentPlus" Width="24" Height="24" VerticalAlignment="Center"/>
                                    <TextBlock Text="Yeni Form" Margin="16,0" VerticalAlignment="Center" FontSize="14"/>
                                </StackPanel>
                            </Button>

                            <Separator Margin="16,8"/>

                            <!-- Reports -->
                            <Button Style="{StaticResource NavigationButton}"
                                    Height="50" HorizontalContentAlignment="Left">
                                <StackPanel Orientation="Horizontal" Margin="16,0">
                                    <materialDesign:PackIcon Kind="ChartBar" Width="24" Height="24" VerticalAlignment="Center"/>
                                    <TextBlock Text="Raporlar" Margin="16,0" VerticalAlignment="Center" FontSize="14"/>
                                </StackPanel>
                            </Button>

                            <!-- Users -->
                            <Button Style="{StaticResource NavigationButton}"
                                    Height="50" HorizontalContentAlignment="Left">
                                <StackPanel Orientation="Horizontal" Margin="16,0">
                                    <materialDesign:PackIcon Kind="AccountMultiple" Width="24" Height="24" VerticalAlignment="Center"/>
                                    <TextBlock Text="Kullanıcılar" Margin="16,0" VerticalAlignment="Center" FontSize="14"/>
                                </StackPanel>
                            </Button>

                            <!-- Settings -->
                            <Button Style="{StaticResource NavigationButton}"
                                    Height="50" HorizontalContentAlignment="Left"
                                    Command="{Binding NavigateToSettingsCommand}">
                                <StackPanel Orientation="Horizontal" Margin="16,0">
                                    <materialDesign:PackIcon Kind="Cog" Width="24" Height="24" VerticalAlignment="Center"/>
                                    <TextBlock Text="Ayarlar" Margin="16,0" VerticalAlignment="Center" FontSize="14"/>
                                </StackPanel>
                            </Button>

                            <Separator Margin="16,8"/>

                            <!-- Exit -->
                            <Button Style="{StaticResource NavigationButton}"
                                    Height="50" HorizontalContentAlignment="Left"
                                    Command="{Binding ExitApplicationCommand}">
                                <StackPanel Orientation="Horizontal" Margin="16,0">
                                    <materialDesign:PackIcon Kind="ExitToApp" Width="24" Height="24" VerticalAlignment="Center"/>
                                    <TextBlock Text="Çıkış" Margin="16,0" VerticalAlignment="Center" FontSize="14"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </ScrollViewer>
                </Border>

                <!-- Content Area -->
                <Grid Grid.Column="1" Margin="16">
                    <!-- Dashboard Cards -->
                    <Grid x:Name="DashboardContent">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Statistics Cards -->
                        <UniformGrid Grid.Row="0" Rows="1" Columns="3" Margin="0,0,0,16">
                            <!-- Total Templates Card -->
                            <materialDesign:Card Margin="0,0,8,0" Padding="16">
                                <StackPanel>
                                    <DockPanel>
                                        <materialDesign:PackIcon Kind="FileDocument" Width="40" Height="40"
                                                                Foreground="{DynamicResource PrimaryHueMidBrush}"/>
                                        <StackPanel DockPanel.Dock="Right" HorizontalAlignment="Right">
                                            <TextBlock Text="{Binding TotalTemplates}"
                                                      FontSize="32" FontWeight="Bold"
                                                      HorizontalAlignment="Right"/>
                                            <TextBlock Text="Toplam Şablon"
                                                      FontSize="14"
                                                      Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                                        </StackPanel>
                                    </DockPanel>
                                </StackPanel>
                            </materialDesign:Card>

                            <!-- Total Forms Card -->
                            <materialDesign:Card Margin="4,0" Padding="16">
                                <StackPanel>
                                    <DockPanel>
                                        <materialDesign:PackIcon Kind="FileDocumentMultiple" Width="40" Height="40"
                                                                Foreground="{DynamicResource SecondaryHueMidBrush}"/>
                                        <StackPanel DockPanel.Dock="Right" HorizontalAlignment="Right">
                                            <TextBlock Text="{Binding TotalForms}"
                                                      FontSize="32" FontWeight="Bold"
                                                      HorizontalAlignment="Right"/>
                                            <TextBlock Text="Toplam Form"
                                                      FontSize="14"
                                                      Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                                        </StackPanel>
                                    </DockPanel>
                                </StackPanel>
                            </materialDesign:Card>

                            <!-- Pending Forms Card -->
                            <materialDesign:Card Margin="8,0,0,0" Padding="16">
                                <StackPanel>
                                    <DockPanel>
                                        <materialDesign:PackIcon Kind="ClockAlert" Width="40" Height="40"
                                                                Foreground="#FF9800"/>
                                        <StackPanel DockPanel.Dock="Right" HorizontalAlignment="Right">
                                            <TextBlock Text="{Binding PendingForms}"
                                                      FontSize="32" FontWeight="Bold"
                                                      HorizontalAlignment="Right"/>
                                            <TextBlock Text="Bekleyen Form"
                                                      FontSize="14"
                                                      Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                                        </StackPanel>
                                    </DockPanel>
                                </StackPanel>
                            </materialDesign:Card>
                        </UniformGrid>

                        <!-- Quick Actions -->
                        <materialDesign:Card Grid.Row="1" Padding="16" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="Hızlı İşlemler" Style="{StaticResource SectionTitle}"/>
                                <WrapPanel Margin="0,8,0,0">
                                    <Button Style="{StaticResource PrimaryButton}" Margin="0,4,8,4">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="FilePlus" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <TextBlock Text="Yeni Şablon Oluştur"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource PrimaryButton}" Margin="0,4,8,4">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="FileDocumentPlus" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <TextBlock Text="Yeni Form Doldur"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource PrimaryButton}" Margin="0,4,8,4">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="FileImport" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <TextBlock Text="Şablon İçe Aktar"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource PrimaryButton}" Margin="0,4,8,4">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="FileExport" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <TextBlock Text="Toplu Dışa Aktar"/>
                                        </StackPanel>
                                    </Button>
                                </WrapPanel>
                            </StackPanel>
                        </materialDesign:Card>

                        <!-- Recent Activity -->
                        <materialDesign:Card Grid.Row="2" Padding="16">
                            <StackPanel>
                                <TextBlock Text="Son Aktiviteler" Style="{StaticResource SectionTitle}"/>
                                <TextBlock Text="Son aktiviteler burada görüntülenecek..."
                                          Margin="0,16"
                                          Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                            </StackPanel>
                        </materialDesign:Card>
                    </Grid>
                </Grid>
            </Grid>

            <!-- Status Bar -->
            <materialDesign:ColorZone Grid.Row="2" Mode="PrimaryLight" Padding="8">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center"
                               Text="FastForm v1.0.0"/>
                    <TextBlock DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center"
                               Text="Hazır"/>
                </DockPanel>
            </materialDesign:ColorZone>
        </Grid>
    </materialDesign:DialogHost>
</Window>
